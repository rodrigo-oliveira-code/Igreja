generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ───────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  TESOUREIRO
  AUX_TESOUREIRO
  CONSELHO_FISCAL
  PASTOR
  LIDER_MINISTERIO
  SECRETARIA
  ADMIN
  LIDER
  MEMBRO
}

enum StatusMembro {
  ATIVO
  INATIVO
  VISITANTE
  TRANSFERIDO
}

enum TipoEvento {
  CULTO
  ENSAIO
  REUNIAO
  CELULA
  CONFERENCIA
  OUTRO
}

enum TipoLancamento {
  RECEITA
  DESPESA
  TRANSFERENCIA
}

enum StatusLancamento {
  RASCUNHO
  PENDENTE
  APROVADO
  PAGO
  REJEITADO
}

enum FormaPagamento {
  ESPECIE
  PIX
  CARTAO
  CHEQUE
  TRANSFERENCIA
  BOLETO
  DEBITO
}

enum TipoContaPlano {
  RECEITA
  DESPESA
  ATIVO
  PASSIVO
}

enum TipoContaBancaria {
  CORRENTE
  POUPANCA
  APLICACAO
  CAIXA
}

enum StatusCaixaCulto {
  ABERTO
  FECHADO
}

enum AcaoAprovacao {
  APROVADO
  REJEITADO
  DEVOLVIDO
}

enum CategoriaPatrimonio {
  IMOVEL
  VEICULO
  EQUIPAMENTO
  MOBILIARIO
  OUTRO
}

enum StatusContrato {
  ATIVO
  ENCERRADO
  SUSPENSO
}

// ─── USUÁRIOS E MEMBROS ───────────────────────────────────

model User {
  id           String                @id @default(cuid())
  email        String                @unique
  password     String?
  nome         String
  role         Role                  @default(MEMBRO)
  membroId     String?               @unique
  membro       Membro?               @relation(fields: [membroId], references: [id])
  createdAt    DateTime              @default(now())
  lancamentos  Lancamento[]          @relation("LancamentoCriador")
  aprovacoes   AprovacaoLancamento[]
  cultoSessoes CultoSessao[]
  auditLogs    AuditLog[]
}

model Membro {
  id                      String        @id @default(cuid())
  nome                    String
  email                   String?       @unique
  telefone                String?
  dataNascimento          DateTime?
  dataIngresso            DateTime?
  status                  StatusMembro  @default(ATIVO)
  foto                    String?
  endereco                String?
  observacoes             String?
  cpf                     String?       @unique
  rg                      String?
  estadoCivil             String?
  profissao               String?
  naturalidade            String?
  nomePai                 String?
  nomeMae                 String?
  dataBatismoAguas        DateTime?
  dataOrdenacaoCooperador DateTime?
  dataOrdenacaoDiacono    DateTime?
  dataOrdenacaoPresbitero DateTime?
  dataOrdenacaoPastor     DateTime?
  departamentos           MembroDepto[]
  escalas                 Escala[]
  lancamentos             Lancamento[]
  user                    User?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
}

// ─── ORGANIZAÇÃO ─────────────────────────────────────────

model Departamento {
  id          String        @id @default(cuid())
  nome        String        @unique
  descricao   String?
  cor         String        @default("#7C3AED")
  liderId     String?
  membros     MembroDepto[]
  escalas     Escala[]
  lancamentos Lancamento[]
  orcamentos  Orcamento[]
  patrimonios Patrimonio[]
  createdAt   DateTime      @default(now())
}

model MembroDepto {
  id             String       @id @default(cuid())
  membroId       String
  departamentoId String
  funcao         String?
  membro         Membro       @relation(fields: [membroId], references: [id])
  departamento   Departamento @relation(fields: [departamentoId], references: [id])

  @@unique([membroId, departamentoId])
}

model Evento {
  id         String     @id @default(cuid())
  titulo     String
  descricao  String?
  data       DateTime
  horaInicio String?
  horaFim    String?
  tipo       TipoEvento @default(CULTO)
  local      String?
  escalas    Escala[]
  createdAt  DateTime   @default(now())
}

model Escala {
  id             String        @id @default(cuid())
  eventoId       String
  membroId       String
  departamentoId String?
  funcao         String
  confirmado     Boolean       @default(false)
  evento         Evento        @relation(fields: [eventoId], references: [id])
  membro         Membro        @relation(fields: [membroId], references: [id])
  departamento   Departamento? @relation(fields: [departamentoId], references: [id])
  createdAt      DateTime      @default(now())

  @@unique([eventoId, membroId, funcao])
}

// ─── FINANCEIRO ───────────────────────────────────────────

model PlanoDeContas {
  id          String          @id @default(cuid())
  codigo      String          @unique
  nome        String
  tipo        TipoContaPlano
  paiId       String?
  pai         PlanoDeContas?  @relation("ContaHierarquia", fields: [paiId], references: [id])
  filhos      PlanoDeContas[] @relation("ContaHierarquia")
  ativo       Boolean         @default(true)
  lancamentos Lancamento[]
  orcamentos  Orcamento[]
  createdAt   DateTime        @default(now())
}

model ContaBancaria {
  id          String            @id @default(cuid())
  nome        String
  banco       String
  agencia     String?
  conta       String
  tipo        TipoContaBancaria @default(CORRENTE)
  saldoAtual  Decimal           @default(0) @db.Decimal(12, 2)
  ativa       Boolean           @default(true)
  lancamentos Lancamento[]
  createdAt   DateTime          @default(now())
}

model Fornecedor {
  id             String       @id @default(cuid())
  nome           String
  cpfCnpj        String?      @unique
  email          String?
  telefone       String?
  dadosBancarios Json?
  ativo          Boolean      @default(true)
  lancamentos    Lancamento[]
  contratos      Contrato[]
  createdAt      DateTime     @default(now())
}

model CultoSessao {
  id                  String           @id @default(cuid())
  data                DateTime
  tipoCulto           String
  responsavelId       String
  responsavel         User             @relation(fields: [responsavelId], references: [id])
  saldoInicial        Decimal          @default(0) @db.Decimal(12, 2)
  totalLancado        Decimal          @default(0) @db.Decimal(12, 2)
  totalContagemFisica Decimal?         @db.Decimal(12, 2)
  divergencia         Decimal?         @db.Decimal(12, 2)
  status              StatusCaixaCulto @default(ABERTO)
  fechadoEm           DateTime?
  lancamentos         Lancamento[]
  createdAt           DateTime         @default(now())
}

model Lancamento {
  id              String                @id @default(cuid())
  tipo            TipoLancamento
  data            DateTime
  valor           Decimal               @db.Decimal(12, 2)
  descricao       String?
  categoria       String?
  contaPlanoId    String?
  contaPlano      PlanoDeContas?        @relation(fields: [contaPlanoId], references: [id])
  departamentoId  String?
  departamento    Departamento?         @relation(fields: [departamentoId], references: [id])
  contaBancariaId String?
  contaBancaria   ContaBancaria?        @relation(fields: [contaBancariaId], references: [id])
  fornecedorId    String?
  fornecedor      Fornecedor?           @relation(fields: [fornecedorId], references: [id])
  formaPagamento  FormaPagamento?
  membroId        String?
  membro          Membro?               @relation(fields: [membroId], references: [id])
  cultoSessaoId   String?
  cultoSessao     CultoSessao?          @relation(fields: [cultoSessaoId], references: [id])
  status          StatusLancamento      @default(APROVADO)
  comprovante     String?
  criadoPorId     String?
  criadoPor       User?                 @relation("LancamentoCriador", fields: [criadoPorId], references: [id])
  aprovacoes      AprovacaoLancamento[]
  ativo           Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model AprovacaoLancamento {
  id            String        @id @default(cuid())
  lancamentoId  String
  lancamento    Lancamento    @relation(fields: [lancamentoId], references: [id])
  aprovadorId   String
  aprovador     User          @relation(fields: [aprovadorId], references: [id])
  acao          AcaoAprovacao
  justificativa String?
  dataAcao      DateTime      @default(now())
}

model Orcamento {
  id             String        @id @default(cuid())
  ano            Int
  departamentoId String
  departamento   Departamento  @relation(fields: [departamentoId], references: [id])
  contaPlanoId   String
  contaPlano     PlanoDeContas @relation(fields: [contaPlanoId], references: [id])
  valorPrevisto  Decimal       @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())

  @@unique([ano, departamentoId, contaPlanoId])
}

model Patrimonio {
  id                   String              @id @default(cuid())
  nome                 String
  categoria            CategoriaPatrimonio
  valorAquisicao       Decimal             @db.Decimal(12, 2)
  dataAquisicao        DateTime
  vidaUtilAnos         Int?
  depreciacaoAcumulada Decimal             @default(0) @db.Decimal(12, 2)
  departamentoId       String?
  departamento         Departamento?       @relation(fields: [departamentoId], references: [id])
  numeroSerie          String?
  ativo                Boolean             @default(true)
  createdAt            DateTime            @default(now())
}

model Contrato {
  id           String         @id @default(cuid())
  fornecedorId String
  fornecedor   Fornecedor     @relation(fields: [fornecedorId], references: [id])
  descricao    String
  valorMensal  Decimal?       @db.Decimal(12, 2)
  dataInicio   DateTime
  dataFim      DateTime?
  status       StatusContrato @default(ATIVO)
  arquivoUrl   String?
  createdAt    DateTime       @default(now())
}

model AuditLog {
  id              String   @id @default(cuid())
  usuarioId       String?
  usuario         User?    @relation(fields: [usuarioId], references: [id])
  entidade        String
  entidadeId      String
  acao            String
  dadosAnteriores Json?
  dadosNovos      Json?
  ip              String?
  createdAt       DateTime @default(now())
}

// ─── CONFIGURAÇÕES ────────────────────────────────────────

model ConfiguracaoIgreja {
  id    String @id @default(cuid())
  chave String @unique
  valor String
}
